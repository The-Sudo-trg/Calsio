# CALSIO — env.template  (copy to .env, fill values; .env is gitignored, never commit it)

# ---------- Database ----------
# Dev default after: docker compose up -d postgres
DATABASE_URL=postgresql://calsio:calsio_dev@localhost:5432/calsio

# ---------- Auth / OTP ----------
OTP_SECRET=generate_a_long_random_string
OTP_TTL_SECONDS=300
# Optional; without it, dev logs OTP codes to the server console (D07)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ---------- AI ----------
# openai | gemini | claude
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- App ----------
ADMIN_TOKEN=generate_another_long_random_string
SESSION_SECRET=generate_yet_another_long_random_string
